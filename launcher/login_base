    # easyocr识别-----图转文->识别文字
    def img_ocr(self):
        # 截图转img
        png = self.driver.get_screenshot_as_png()
        img = cv2.imdecode(np.frombuffer(png, np.uint8), cv2.IMREAD_COLOR)
        # 读取语言列表并做识别
        results = self.reader.readtext(img)
        # print(results)
        print("正在进行 OCR 识别...")
        target_found = False
        target_texts = ["CONTINUE", "CONTINUAR"]  # 同时匹配英文和葡萄牙语

        # 遍历识别到的结果
        for (bbox, text, conf) in results:
            print(f"识别到: '{text}' (置信度: {conf:.2f})")

            # 遍历匹配目标文字
            for target in target_texts:
                if conf < 0.5:
                    continue
                if target.lower() in text.lower():
                    # 计算文字中心点
                    (top_left, top_right, bottom_right, bottom_left) = bbox
                    center_x = int((top_left[0] + bottom_right[0]) / 2)
                    center_y = int((top_left[1] + bottom_right[1]) / 2)

                    print(f"找到 '{text}'，中心坐标: ({center_x}, {center_y})")

                    # 画框保存调试图
                    pts = np.array(bbox, np.int32).reshape((-1, 1, 2))
                    cv2.polylines(img, [pts], True, (0, 255, 0), 2)
                    cv2.imwrite("found.png", img)

                    # 点击
                    actions = ActionChains(self.driver)
                    actions.move_by_offset(center_x, center_y).click().perform()
                    print("已点击按钮")

                    # 复位鼠标位置
                    actions.move_by_offset(-center_x, -center_y).perform()
                    target_found = True
                    break

            if target_found:
                break

        if not target_found:
            cv2.imwrite("not_found.png", img)
            print("未找到 CONTINUE / CONTINUAR 按钮")

    #图片识别
    def find_button_multiscale(self, template_path="menu.png", matchvalue=0.5, save_dir="./findimg",save_nodir="./nofindimg"):
        png = self.driver.get_screenshot_as_png()
        img = cv2.imdecode(np.frombuffer(png, np.uint8), cv2.IMREAD_COLOR)

        template = cv2.imread(template_path)
        if template is None:
            raise FileNotFoundError(f"找不到模板: {template_path}")

        # 类型/通道统一
        if img.dtype != template.dtype:
            template = template.astype(img.dtype)
        if len(img.shape) == 2:
            img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)
        if len(template.shape) == 2:
            template = cv2.cvtColor(template, cv2.COLOR_GRAY2BGR)

        best_val = -1
        best_loc = None
        best_scale = 1.0
        best_template = None

        # 多尺度0.2x ~ 1.0x
        for scale in [i / 10.0 for i in range(2, 11)]:
            resized = cv2.resize(template, None, fx=scale, fy=scale, interpolation=cv2.INTER_LINEAR)

            # 跳过比截图大的
            if resized.shape[0] > img.shape[0] or resized.shape[1] > img.shape[1]:
                continue

            result = cv2.matchTemplate(img, resized, cv2.TM_CCOEFF_NORMED)
            _, max_val, _, max_loc = cv2.minMaxLoc(result)

            if max_val > best_val:
                best_val = max_val
                best_loc = max_loc
                best_scale = scale
                best_template = resized

        print(f"最佳匹配度: {best_val:.3f}, 缩放比例: {best_scale}")

        # 确保保存目录存在
        os.makedirs(save_dir, exist_ok=True)

        if best_val > matchvalue:
            h, w = best_template.shape[:2]
            center_x = best_loc[0] + w // 2
            center_y = best_loc[1] + h // 2

            # 可视化
            debug = img.copy()
            cv2.rectangle(debug, best_loc, (best_loc[0] + w, best_loc[1] + h), (0, 255, 0), 2)

            # 指定保存路径
            found_path = os.path.join(save_dir, f"found_{best_val:.2f}_{best_scale:.1f}.png")
            cv2.imwrite(found_path, debug)

            print(f"找到按钮，窗口内坐标: ({center_x}, {center_y})")
            time.sleep(1)

            # 视口坐标转屏幕坐标
            viewport_info = self.driver.execute_script("""
                return {
                    screenX: window.screenX || window.screenLeft,
                    screenY: window.screenY || window.screenTop,
                    outerWidth: window.outerWidth,
                    outerHeight: window.outerHeight,
                    innerWidth: window.innerWidth,
                    innerHeight: window.innerHeight
                };
            """)

            # 计算浏览器边框和标题栏偏移
            chrome_offset_x = (viewport_info['outerWidth'] - viewport_info['innerWidth']) // 2
            chrome_offset_y = viewport_info['outerHeight'] - viewport_info['innerHeight']

            # 视口在屏幕的绝对位置
            viewport_x = viewport_info['screenX'] + chrome_offset_x
            viewport_y = viewport_info['screenY'] + chrome_offset_y

            # 屏幕绝对坐标
            screen_x = viewport_x + center_x
            screen_y = viewport_y + center_y

            print(f"视口偏移: x={chrome_offset_x}, y={chrome_offset_y}")
            print(f"屏幕坐标: ({screen_x}, {screen_y})")

            # 移动并点击
            pyautogui.moveTo(screen_x, screen_y, duration=0.2)
            pyautogui.click()

            print("点击完成")
            return True

        # 未找到
        notfound_path = os.path.join(save_nodir, f"notfound_{best_val:.2f}_{best_scale:.1f}.png")
        cv2.imwrite(notfound_path, img)
        print("未找到，调试图已保存")
        return False
