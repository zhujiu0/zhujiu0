    #等待动画
    def loading_wait(self,seconds: int, width: int = 40, prefix: str = "加载中"):

        for i in range(seconds + 1):
            percent = i / seconds
            filled = int(width * percent)
            bar = "█" * filled + "░" * (width - filled)
            sys.stdout.write(f"\r{prefix} |{bar}| {i}/{seconds}s")
            sys.stdout.flush()
            if i < seconds:
                time.sleep(1)
        sys.stdout.write("\n")

